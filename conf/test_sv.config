// Synthetic caller VCFs describing NA12878 deletions, genotyped in svtyper's NA12878 fixture BAM.
// No reference FASTA, so clip-matching flags are dropped (svtyper_run.py warns).
params {
    samplesheet     = "${projectDir}/tests/data/synthetic/sv_samplesheet.csv"
    target_bam      = "${projectDir}/tests/data/svtyper/NA12878.target_loci.sorted.bam"
    sample_id       = 'NA12878'
    reference_fasta = null
    sv_chunk_size   = 4
}
