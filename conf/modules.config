// Publishing: final tables/QC at ${params.outdir}/, unions under union/, per-input stats under inputs/.
process {
    withName: 'SNV_FINALIZE|SV_FINALIZE' {
        publishDir = [path: { "${params.outdir}" }, mode: 'copy',
                      saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'SNV_UNION' {
        publishDir = [path: { "${params.outdir}/union" }, mode: 'copy', pattern: '*_union_snvs.*']
    }
    withName: 'SV_UNION' {
        publishDir = [path: { "${params.outdir}/union" }, mode: 'copy', pattern: '*_union_svs.*']
    }
    withName: 'SVTYPER_LIBINFO' {
        publishDir = [path: { "${params.outdir}" }, mode: 'copy', pattern: '*.lib_info.json']
    }
    withName: 'SNV_EXTRACT|SV_NORMALIZE' {
        publishDir = [path: { "${params.outdir}/inputs" }, mode: 'copy', pattern: '*.stats.json']
    }
}
