// Publishing: final tables/QC (and svtyper lib info) at ${params.outdir}/, unions under union/,
// per-input stats under inputs/. Each selector names processes of both entry scripts so that
// neither entry warns about selectors that match no process.
process {
    withName: 'SNV_FINALIZE|INDEL_FINALIZE|SV_FINALIZE|SVTYPER_LIBINFO' {
        publishDir = [path: { "${params.outdir}" }, mode: 'copy',
                      saveAs: { fn -> fn == 'versions.yml' ? null : fn }]
    }
    withName: 'SNV_UNION|INDEL_UNION|SV_UNION' {
        publishDir = [path: { "${params.outdir}/union" }, mode: 'copy', pattern: '*_union_*']
    }
    withName: 'SNV_EXTRACT|INDEL_EXTRACT|SV_NORMALIZE' {
        publishDir = [path: { "${params.outdir}/inputs" }, mode: 'copy', pattern: '*.stats.json']
    }
}
