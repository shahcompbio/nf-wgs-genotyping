// Synthetic SNV data (tests/make_fixtures.py): expected truth in tests/data/synthetic/truth.json.
params {
    samplesheet     = "${projectDir}/tests/data/synthetic/snv_samplesheet.csv"
    target_bam      = "${projectDir}/tests/data/synthetic/target.bam"
    sample_id       = 'T1'
    reference_fasta = "${projectDir}/tests/data/synthetic/ref.fa"
    contigs         = '1,2'
    snv_chunk_size  = 2
}
