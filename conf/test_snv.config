// Synthetic SNV + indel data (tests/make_fixtures.py): expected truth in tests/data/synthetic/truth.json.
params {
    samplesheet      = "${projectDir}/tests/data/synthetic/samplesheet.csv"
    target_bam       = "${projectDir}/tests/data/synthetic/target.bam"
    sample_id        = 'T1'
    reference_fasta  = "${projectDir}/tests/data/synthetic/ref.fa"
    contigs          = '1,2,3'
    snv_chunk_size   = 2
    indel_chunk_size = 2
}
