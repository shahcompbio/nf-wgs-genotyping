// MSK iris (SLURM + Singularity). Matches the `iris` profile of isabl_apps nextflow/base.config,
// so the two merge cleanly when isabl adds its base.config with -config.
executor {
    name              = 'slurm'
    queueSize         = 2000
    submitRateLimit   = '200/2min'
    perJobMemLimit    = true
    pollInterval      = '45sec'
    queueStatInterval = '2min'
}
singularity {
    enabled     = true
    autoMounts  = true
    pullTimeout = '90m'
    cacheDir    = '/data1/papaemme/isabl/opt/singularity'
}
process {
    queue = 'componc_cpu'
}
